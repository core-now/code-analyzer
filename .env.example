# ==============================================================================
# Codebase Analyzer - Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env and adjust the settings to your local environment.
# Example: cp .env.example .env

# ------------------------------------------------------------------------------
# 1. Server & Networking
# ------------------------------------------------------------------------------
# Port the local Codebase Analyzer backend listens on (Default: 8084 or 8000)
PORT=8084
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. Authentication & JWT Security
# ------------------------------------------------------------------------------
# Secret key used for signing JWT tokens and PBKDF2 salt (Change in production!)
AUTH_SECRET=your-super-secret-jwt-key-min-32-chars-long
# Legacy alias support for AUTH_SECRET
SUPER_SALT=your-super-secret-jwt-key-min-32-chars-long
# JWT token validity in seconds (Default: 86400 = 24 hours)
JWT_EXPIRATION_SECONDS=86400
# JWT token expiration in hours (Alternative config)
JWT_EXPIRATION_HOURS=24

# ------------------------------------------------------------------------------
# 3. GitHub OAuth Single Sign-On (SSO)
# ------------------------------------------------------------------------------
# GitHub OAuth App Client ID (leave empty to disable GitHub login)
GITHUB_CLIENT_ID=
# GitHub OAuth App Client Secret
GITHUB_CLIENT_SECRET=
# Optional explicit callback URL (default is dynamically detected based on host)
GITHUB_REDIRECT_URI=http://localhost:8084/api/auth/github/callback

# ------------------------------------------------------------------------------
# 4. Database Persistence (MSSQL / SQLite Resilient Fallback)
# ------------------------------------------------------------------------------
# If DB_SERVER, DB_USER, and DB_SECRET are provided, the system attempts MSSQL
# via pymssql or pyodbc. If unreachable or unconfigured, it automatically falls
# back to SQLite without crashing or losing functionality.
DB_SERVER=
DB_PORT=1433
DB_NAME=AnalyzerDB
DB_USER=
DB_SECRET=
# Optional path for SQLite fallback database
SQLITE_DB_PATH=analyzer.db

# ------------------------------------------------------------------------------
# 5. Universal LLM Engine (Ollama / llama.cpp Server / OpenAI-compatible / LM Studio)
# ------------------------------------------------------------------------------
# Default provider: 'ollama' | 'llamacpp' | 'openai'
DEFAULT_LLM_PROVIDER=ollama

# Default LLM Endpoint URLs:
# - Ollama Native:                 http://localhost:11434/api/generate (or /api/chat)
# - Ollama OpenAI Compat:          http://localhost:11434/v1/chat/completions
# - llama.cpp Server (Native):     http://localhost:8080/completion
# - OpenAI / LM Studio / vLLM:     http://localhost:1234/v1/chat/completions
DEFAULT_LLM_URL=http://localhost:11434/v1/chat/completions
LLM_URL=http://localhost:11434/v1/chat/completions

# Default model name
DEFAULT_LLM_MODEL=qwen2.5-coder:7b
LLM_MODEL=qwen2.5-coder:7b

# Optional API Key for authenticated endpoints (OpenAI / OpenRouter / Groq)
LLM_API_KEY=

# ------------------------------------------------------------------------------
# 6. Cache & Snapshot Persistence Files
# ------------------------------------------------------------------------------
CACHE_FILE=codebase_analysis_cache.json
RESULTS_FILE=codebase_analysis_results.json
WORKSPACE_DIR=.
