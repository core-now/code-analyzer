# ==============================================================================
# Git Ignore - Code-Analyzer
# ==============================================================================

# Internal documentation & private notes
gemini_info.md

# Analysis caches & large generated result dumps
codebase_analysis_cache.json
codebase_analysis_results.json
.codebase_cache.json
.codebase_results.json

# Scratch & temporary workspace directories
scratch/
temp/
tmp/
*.tmp

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.pyo

# Python virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Node & JavaScript dependencies / builds
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Log files
*.log
logs/

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# IDE & Editor settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project
.settings/

# Media files (excluded from code repositories & system analysis)
*.mp4
*.webm
*.avi
*.mov
*.mkv

# Environment & secrets
.env
.env.local
.env.*.local
*.pem
*.key
